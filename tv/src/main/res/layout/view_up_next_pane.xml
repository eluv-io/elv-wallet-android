<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/up_next_card"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginHorizontal="48dp"
        android:layout_marginVertical="45dp"
        android:background="@drawable/round_corner_medium"
        android:backgroundTint="#CC000000"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/up_next_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            tools:text="Up Next in 10" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/up_next_thumbnail"
                android:layout_width="195dp"
                android:layout_height="110dp"
                android:background="@drawable/round_corner_medium"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/up_next_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Episode 2" />

                <TextView
                    android:id="@+id/up_next_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp"
                    tools:text="Season 1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <app.eluvio.wallet.screens.videoplayer.ui.MediaGlowTextButton
                android:id="@+id/up_next_cancel"
                style="@style/MediaPlayerTextButton"
                android:layout_marginEnd="12dp"
                android:focusable="true"
                android:paddingVertical="10dp"
                android:text="@string/up_next_cancel"
                app:cornerRadius="8dp" />

            <app.eluvio.wallet.screens.videoplayer.ui.MediaGlowTextButton
                android:id="@+id/up_next_play"
                style="@style/MediaPlayerTextButton"
                android:drawableStart="@drawable/lb_ic_play"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:paddingVertical="10dp"
                android:text="@string/up_next_play_now"
                app:cornerRadius="8dp"
                app:drawableTint="@color/media_button_text_color"
                app:unfocusedBackgroundColor="#40FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
